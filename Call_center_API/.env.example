# =====================================================================
# Front-figma - Variables d'environnement (frontend Vite/React)
# Copier ce fichier en ".env" (dev local) et renseigner les vraies valeurs.
# En production (Vercel), définir VITE_API_URL dans les "Environment
# Variables" du projet Vercel plutôt que dans un fichier .env commité.
# =====================================================================

# URL de base de l'API backend (FastAPI)
# En local :
VITE_API_URL=http://127.0.0.1:8000

# En production, exemple :
# VITE_API_URL=https://labpro.onrender.com
